# Секреты заполнить только в локальном .env, не коммитить.
DATABASE_URL=
SECRET_KEY=
APP_PORT=5000
FLASK_ENV=development
POSTGRES_USER=studenttrack
POSTGRES_PASSWORD=
POSTGRES_DB=studenttrack

# ДОПУЩЕНИЕ: локальный registry без аутентификации на loopback.
REGISTRY_URL=127.0.0.1:5000
REGISTRY_IMAGE=127.0.0.1:5000/studenttrack
# Для registry с настроенной аутентификацией.
REGISTRY_USER=
REGISTRY_PASSWORD=
